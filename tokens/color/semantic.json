    },
    "disabled": {
      "$value": "{palette.neutral.400}",
      "$type": "color",
      "$description": "Deliberately below AA. A disabled control is exempt from contrast, and using this anywhere else is a violation."
    },
    "inverse": {
      "$value": "{palette.neutral.0}",
