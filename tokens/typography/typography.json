    "sm": {
      "$value": "20px",
      "$type": "dimension"
    },
    "md": {
      "$value": "24px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "28px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "32px",
      "$type": "dimension"
    }
  }
}
