{
  "motion": {
    "duration": {
      "instant": {
        "$value": "0ms",
        "$type": "duration",
        "$description": "No transition — immediate state change"
      },
      "fast": {
        "$value": "100ms",
        "$type": "duration",
        "$description": "Fast micro-interactions (hover, focus)"
      },
      "medium": {
        "$value": "200ms",
        "$type": "duration",
        "$description": "Medium-speed UI animations — tab indicator slide, shared element transitions"
      },
      "normal": {
        "$value": "150ms",
        "$type": "duration",
        "$description": "Standard UI transition — color, opacity, border (between fast 100ms and medium 200ms)"
      },
      "slow": {
        "$value": "400ms",
        "$type": "duration",
        "$description": "Slow transitions (page-level, modal)"
      },
      "row-highlight": {
        "$value": "1400ms",
        "$type": "duration",
        "$description": "Row pulse highlight duration (Command Center rowPulse animation)"
      }
    },
    "easing": {
      "ease-in": {
        "$value": [0.4, 0, 1, 1],
        "$type": "cubicBezier",
        "$description": "Ease-in — accelerating from zero"
      },
      "ease-out": {
        "$value": [0, 0, 0.2, 1],
        "$type": "cubicBezier",
        "$description": "Ease-out — decelerating to zero"
      },
      "ease-in-out": {
        "$value": [0.4, 0, 0.2, 1],
        "$type": "cubicBezier",
        "$description": "Standard ease-in-out"
      },
      "row-highlight": {
        "$value": [0, 0, 0.2, 1],
        "$type": "cubicBezier",
        "$description": "Row pulse easing (Command Center rowPulse — ease-out)"
      }
    }
  }
}
